{
  "name": "@tokyo3rdhq/magi-design-system",
  "version": "0.4.2",
  "description": "Shared visual foundation for the MAGI product family — dark-first, near-monochrome, restrained.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "keywords": [
    "magi",
    "design-system",
    "ui",
    "react",
    "dark-theme",
    "tokens",
    "components"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tokyo3rdhq/magi-design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokyo3rdhq/magi-design-system.git",
    "directory": "packages/design-system"
  },
  "bugs": {
    "url": "https://github.com/tokyo3rdhq/magi-design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}